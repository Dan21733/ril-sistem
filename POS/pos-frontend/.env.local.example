# Salin file ini menjadi .env.local atau .env (ter-ignore, tidak pernah
# di-commit). Isi dengan nilai DEVICE_REGISTRATION_TOKEN dari .env backend.
#
# Token ini dipakai dev server (Vite proxy) untuk mendaftarkan device kasir
# secara otomatis ke POST /api/devices/register/. Setelah mengubah nilai ini,
# jalankan ulang dev server (npm run dev).
#
# Pilih nama TANPA prefix VITE_: variabel berprefix VITE_ berpotensi
# terekspos ke browser lewat import.meta.env.
#
# Tanpa nilai ini, auto-registrasi akan menerima 401 dari backend dan kasir
# diminta menghubungi pemilik.
# JANGAN menempelkan nilai asli ke berkas ini — berkas ini ikut ter-commit.
# Ambil nilainya dari DEVICE_REGISTRATION_TOKEN di POS/pos-backend/.env.
DEVICE_REGISTRATION_TOKEN=isi_dengan_token_dari_env_backend

# ---------------------------------------------------------------------------
# Identitas toko yang tercetak di kepala nota dan di surat jalan.
#
# Isinya memang tampil di nota pelanggan, jadi prefix VITE_ di sini benar —
# beda dengan token di atas yang tidak boleh sampai ke browser. Semua nilai ini
# bukan rahasia dan aman ikut di-commit, tapi tetap ditulis di berkas lokal
# supaya outlet lain bisa memakai nilai berbeda tanpa mengubah kode.
#
# Kosong berarti barisnya tidak dicetak: nota tanpa alamat lebih baik daripada
# nota bertuliskan alamat karangan. Setelah mengubah nilai di bawah, jalankan
# ulang dev server (npm run dev) supaya terbaca.
#
# Nilai yang sudah terpasang bisa diperiksa dengan:
#   cd pos-backend
#   venv\Scripts\python.exe tools\setup_env.py --check
# VITE_STORE_NAME=Nama Toko
# VITE_STORE_ADDRESS=Jl. Contoh No.19, Kota
# VITE_STORE_PHONE=0812xxxxxxx
#
# Awalan nomor dokumen surat jalan: formulir toko memakai kode toko + cap waktu.
# Kalau kosong, yang tercetak hanya cap waktunya.
# VITE_STORE_CODE=164135

# ---------------------------------------------------------------------------
# Alamat komputer yang menjalankan penghubung cetak (bridge.py, port 9101) —
# bukan alamat printer: printer memakai port 9100 dan bukan HTTP. Kalau
# penghubung cetak jalan di komputer yang sama dengan dev server, biarkan baris
# ini sebagai komentar; nilai bawaannya sudah http://127.0.0.1:9101.
# PRINT_BRIDGE_TARGET=http://127.0.0.1:9101
