[TEMPLATE]
# Contoh isi berkas pos-backend/.env.
#
# Cara termudah: jangan salin berkas ini dengan tangan, tapi jalankan
#
#     venv\Scripts\python.exe tools\setup_env.py
#
# Skrip itu mengisi ketiga rahasia di bawah secara otomatis dan menyalin
# DEVICE_REGISTRATION_TOKEN ke pos-frontend/.env.local, sehingga tidak ada
# kesempatan token backend dan frontend berbeda (gejalanya: kasir ditolak 401
# dengan pesan "Invalid device registration token.").
#
# JANGAN menempelkan nilai asli ke berkas ini — berkas ini ikut ter-commit.

# Koneksi PostgreSQL dari pemilik database (wajib).
# Database tujuan harus sudah punya seluruh tabel POS; repo ini tidak memuat
# skrip pembuatannya (lihat POS/docs/schema.dbml dan POS/ERD.png).
# Format: postgresql://user:sandi@host:port/nama_database
# Karakter khusus di sandi harus di-encode: # -> %23, @ -> %40, : -> %3A.
DATABASE_URL=postgresql://user:sandi@host:5432/nama_database

# Kunci internal Django (wajib). Boleh hasil setup_env.py.
SECRET_KEY=ganti_dengan_kunci_acak_panjang

# Kunci penanda tangan device token (wajib). Menggantinya membuat seluruh device
# kasir harus registrasi ulang.
DEVICE_AUTH_SIGNING_KEY=ganti_dengan_kunci_acak_panjang

# Rahasia untuk POST /api/devices/register/ (wajib). Harus sama persis dengan
# DEVICE_REGISTRATION_TOKEN di pos-frontend/.env.local.
DEVICE_REGISTRATION_TOKEN=ganti_dengan_token_acak

# Target migrasi Neon satu-kali (opsional, tidak dibaca saat operasi normal).
# Dipakai skrip migrasi sekali-pakai; skripnya wajib dihapus setelah
# verifikasi (lihat POS/AGENTS.md §3). Nilai asli hanya di .env.
# Contoh: NEON_URL=postgresql://user:sandi@host/neon_database?sslmode=require

# Database PostgreSQL disposable khusus pengujian (opsional, tidak dibaca
# saat operasi normal). Wajib diisi saat menjalankan suite PostgreSQL:
# tools/run_pg_tests.py memakainya sebagai DATABASE_URL dan menolak bila
# sama dengan DATABASE_URL operasional. Minta koneksinya ke pemilik
# database; jangan mengarang atau memakai database produksi.
# Contoh: POS_TEST_DATABASE_URL=postgresql://user:sandi@host:5432/pos_test
